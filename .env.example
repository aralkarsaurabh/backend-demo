PORT=3000

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/backend_demo

# Optional. Integration tests wipe tables, so they only run against a database whose name
# ends in "_test". If unset, it is DATABASE_URL with "_test" added to the database name
# (create that database first, e.g. backend_demo_test).
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/backend_demo_test

# Use two different long random strings (e.g. `openssl rand -base64 48`)
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# Only needed when running `npm run seed:deploy` (create-admin-user seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
