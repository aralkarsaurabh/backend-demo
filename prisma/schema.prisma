generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
}

model RefreshToken {
  id         String    @id @default(uuid()) // equals the JWT jti
  userId     String
  familyId   String // one family per login; inherited on every rotation
  tokenHash  String    @unique // SHA-256 of the token, never the token itself
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model SeedMigration {
  id        String   @id @default(uuid())
  name      String   @unique // seed filename, e.g. 20261001000000_create-admin-user
  appliedAt DateTime @default(now())

  @@map("_seed_migrations")
}
